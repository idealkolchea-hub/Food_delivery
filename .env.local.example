# BiteBlast — Environment Variables
# Copy this file to .env.local and fill in your Supabase keys

# ── Supabase ────────────────────────────────────────────────────
# Get these from: supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Legacy keys kept for old Next.js scaffold compatibility
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ─────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:3010
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── External APIs (add when ready) ──────────────────────────────
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# RAZORPAY_KEY_ID=your-razorpay-key
# RAZORPAY_KEY_SECRET=your-razorpay-secret
